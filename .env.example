# Keine echten Schlüssel eintragen oder einchecken. Je Umgebung separat verwalten.
APP_ENV=local
CLUB_MODE=off
SITE_URL=http://localhost:3120
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Erst nach SMTP-Einrichtung aktivieren.
AUTH_EMAIL_ENABLED=false
# Nur nach separater Testmigration und Prüfung freigeben.
CLUB_SUPABASE_PROJECT_REF=

# Wallet bleibt bis zu Implementierungs- UND offiziellen Gerätetests gesperrt.
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERTIFICATE_BASE64=
APPLE_PASS_PRIVATE_KEY_BASE64=
APPLE_PASS_PRIVATE_KEY_PASSPHRASE=
APPLE_WWDR_CERTIFICATE_BASE64=
WALLET_TOKEN_ENCRYPTION_KEY=
WALLET_WEB_SERVICE_URL=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY_BASE64=
GOOGLE_WALLET_ALLOWED_ORIGINS=

# Verkaufsmodule haben zusätzlich eine feste Codesperre; diese Werte aktivieren nichts.
COMMERCE_PREORDER_ENABLED=false
COMMERCE_SHOP_ENABLED=false
COMMERCE_GIFTCARDS_ENABLED=false
COMMERCE_SUBSCRIPTIONS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
